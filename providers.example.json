{
  "providers": {
    "claude-code": {
      "kind": "claude-code",
      "binary": "claude"
    },
    "codex": {
      "kind": "codex",
      "binary": "codex",
      "model": "gpt-5.6-sol",
      "sandbox": "workspace-write"
    },
    "custom-agent": {
      "kind": "command",
      "command": ["my-agent", "--prompt", "{{ prompt }}"],
      "resumeCommand": ["my-agent", "--session", "{{ session_id }}", "--prompt", "{{ prompt }}"]
    }
  }
}
