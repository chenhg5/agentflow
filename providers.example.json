{
  "drivers": {
    "claude-code": {
      "command": ["claude", "--print", "{{ prompt }}"],
      "resumeCommand": ["claude", "--resume", "{{ session_id }}", "--print", "{{ prompt }}"]
    },
    "codex": {
      "command": ["codex", "exec", "{{ prompt }}"],
      "resumeCommand": ["codex", "exec", "resume", "{{ session_id }}", "{{ prompt }}"]
    }
  }
}
