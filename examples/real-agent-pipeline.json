{
  "version": "2",
  "name": "real-agent-pipeline",
  "entry": "claude_inspect",
  "inputs": {
    "workspace": {
      "type": "string",
      "required": true
    }
  },
  "nodes": [
    {
      "id": "claude_inspect",
      "input": {
        "workspace": "{{ inputs.workspace }}",
        "prompt": "Read input.txt in the current workspace. Do not modify input.txt or any other source file. Write exactly one JSON object to AGENTFLOW_RESULT_FILE with keys summary (string), line_count (number), and reviewed_by (string). Set reviewed_by to claude-code. The summary must mention the fixture text. You may use shell commands only to inspect the file and write the required result file."
      },
      "inputSchema": {
        "type": "object",
        "required": [
          "workspace",
          "prompt"
        ],
        "properties": {
          "workspace": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "summary",
          "line_count",
          "reviewed_by"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "line_count": {
            "type": "integer",
            "minimum": 1
          },
          "reviewed_by": {
            "type": "string",
            "enum": [
              "claude-code"
            ]
          }
        },
        "additionalProperties": false
      },
      "timeoutMs": 180000,
      "executor": "claude-code"
    },
    {
      "id": "codex_verify",
      "input": {
        "summary": "{{ nodes.claude_inspect.result.summary }}",
        "line_count": "{{ nodes.claude_inspect.result.line_count }}",
        "prompt": "Verify the previous agent's structured result: summary={{ nodes.claude_inspect.result.summary }}, line_count={{ nodes.claude_inspect.result.line_count }}. Read input.txt yourself and compare. Do not modify source files. Write exactly one JSON object to AGENTFLOW_RESULT_FILE with keys verified (boolean), observed_line_count (number), and reviewed_by (string). Set reviewed_by to codex.",
        "workspace": "{{ inputs.workspace }}"
      },
      "inputSchema": {
        "type": "object",
        "required": [
          "summary",
          "line_count",
          "prompt"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "line_count": {
            "type": "integer",
            "minimum": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "verified",
          "observed_line_count",
          "reviewed_by"
        ],
        "properties": {
          "verified": {
            "type": "boolean"
          },
          "observed_line_count": {
            "type": "integer",
            "minimum": 1
          },
          "reviewed_by": {
            "type": "string",
            "enum": [
              "codex"
            ]
          }
        },
        "additionalProperties": false
      },
      "timeoutMs": 180000,
      "executor": "codex"
    }
  ],
  "edges": [
    {
      "from": "claude_inspect",
      "to": "codex_verify"
    },
    {
      "from": "codex_verify",
      "to": "$end"
    }
  ]
}
