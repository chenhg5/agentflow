{
  "version": "3",
  "name": "smoke",
  "entry": "greet",
  "inputs": {
    "name": {
      "type": "string",
      "required": true
    }
  },
  "nodes": [
    {
      "id": "greet",
      "execution": {"candidates": [{"executor": "process", "config": {
        "command": [
          "sh",
          "-c",
          "printf 'hello %s\\n' \"$1\"; printf '{\"message\":\"hello %s\"}\\n' \"$1\" > \"$AGENTFLOW_RESULT_FILE\"",
          "sh",
          "{{ inputs.name }}"
        ]
      }}]}
    },
    {
      "id": "approve",
      "execution": {"candidates": [{"executor": "external"}]}
    },
    {
      "id": "finish",
      "execution": {"candidates": [{"executor": "process", "config": {
        "command": [
          "sh",
          "-c",
          "printf 'workflow complete\\n'; printf '{\"done\":true}\\n' > \"$AGENTFLOW_RESULT_FILE\"",
          "sh"
        ]
      }}]}
    }
  ],
  "edges": [
    {
      "from": "greet",
      "to": "approve"
    },
    {
      "from": "approve",
      "to": "finish",
      "when": "nodes.approve.result.decision == 'happy'"
    },
    {
      "from": "approve",
      "to": "$end"
    },
    {
      "from": "finish",
      "to": "$end"
    }
  ]
}
