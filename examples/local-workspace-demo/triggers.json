{
  "triggers": [
    {
      "id": "daily-field-note",
      "enabled": true,
      "source": {
        "kind": "cron",
        "expression": "0 9 * * *",
        "timezone": "Asia/Shanghai"
      },
      "target": {"workflow": "workflow.json"},
      "inputs": {"topic": "field-note"},
      "policy": {"concurrency": "forbid", "misfire": "skip"}
    }
  ]
}
