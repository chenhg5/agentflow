{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lark adapter config (candidate.config only; not graph schema)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recipient",
    "title",
    "sections",
    "actions"
  ],
  "properties": {
    "profile": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "recipient": {
      "type": "string",
      "minLength": 1,
      "description": "User open_id from the SAME app/profile. Templates are rendered by AgentFlow.",
      "pattern": "\\S"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "subtitle": {
      "type": "string"
    },
    "hint": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "content"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "output"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          },
          "output": {
            "type": "object",
            "description": "Arbitrary business fields. Must satisfy the node outputSchema."
          },
          "style": {
            "enum": [
              "default",
              "primary_filled",
              "danger",
              "danger_filled",
              "text"
            ]
          },
          "color": {
            "enum": [
              "blue",
              "green",
              "orange",
              "red",
              "grey",
              "default"
            ]
          },
          "confirm": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "confirmation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "formOutput": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Map fresh top-level output keys to known form names. Must not overlap fixed output."
          },
          "requiredFormFields": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "label",
              "maxLength"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^(?!af_)[A-Za-z][A-Za-z0-9_]{0,63}$"
              },
              "type": {
                "enum": [
                  "text",
                  "multiline"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              }
            }
          }
        }
      }
    },
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "afterSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "output": {
          "type": "object",
          "description": "Explicit timeout output; no implicit choice. Must satisfy node outputSchema."
        }
      },
      "oneOf": [
        {
          "required": [
            "at"
          ],
          "not": {
            "required": [
              "afterSeconds"
            ]
          }
        },
        {
          "required": [
            "afterSeconds"
          ],
          "not": {
            "required": [
              "at"
            ]
          }
        }
      ]
    },
    "preSubmit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "timeoutSeconds"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      },
      "description": "Read-only/idempotent argv hook; immutable request envelope on stdin. Must emit JSON {ok:true}. Business freshness application should also be gated atomically downstream."
    }
  }
}
