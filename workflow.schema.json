{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentflow.dev/schema/workflow-v1.json",
  "title": "AgentFlow Workflow",
  "type": "object",
  "required": ["version", "name", "nodes"],
  "properties": {
    "version": { "const": "1" },
    "name": { "type": "string", "minLength": 1 },
    "inputs": { "type": "object", "additionalProperties": { "$ref": "#/$defs/input" } },
    "maxParallel": { "type": "integer", "minimum": 1, "description": "Maximum nodes running at once; default 4" },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } }
  },
  "$defs": {
    "input": {
      "type": "object",
      "properties": { "type": { "enum": ["string", "number", "boolean", "path"] }, "required": { "type": "boolean" } },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["shell", "agent", "human"] },
        "provider": { "type": "string" },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "prompt": { "type": "string" },
        "promptMode": { "enum": ["arg", "stdin"] },
        "workspace": { "type": "string" },
        "session": { "type": "string", "minLength": 1, "description": "Existing agent session ID or a template resolving to one" },
        "input": { "type": "object", "description": "Structured input template passed to this node" },
        "inputSchema": { "$ref": "#/$defs/contract", "description": "Runtime JSON contract for the rendered node input" },
        "outputSchema": { "$ref": "#/$defs/contract", "description": "Runtime JSON contract for the structured node result" },
        "inputFields": { "type": "array", "items": { "$ref": "#/$defs/field" }, "description": "Named input fields exposed to agents and used for automatic handoff" },
        "outputFields": { "type": "array", "items": { "$ref": "#/$defs/field" }, "description": "Named output fields exposed to agents and used to derive a strict output contract" },
        "inputMapping": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Explicit target-field mappings such as $node.inspect.output.summary or $output.summary" },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "result": {
          "type": "object",
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "required": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "needs": { "type": "array", "items": { "type": "string" } },
        "when": { "type": "string" },
        "runIf": { "enum": ["success", "failure", "always"], "description": "success (default): all needs succeeded; failure: an upstream node failed; always: all needs finished" },
        "retry": { "type": "object", "properties": { "maxAttempts": { "type": "integer", "minimum": 1 } }, "additionalProperties": false }
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "description": "JSON Schema draft 2020-12 contract. AgentFlow validates the full schema at workflow load and node execution.",
      "properties": {
        "type": { "enum": ["object", "array", "string", "number", "integer", "boolean", "null"] },
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/contract" } },
        "required": { "type": "array", "items": { "type": "string" } },
        "additionalProperties": { "type": "boolean" },
        "items": { "$ref": "#/$defs/contract" },
        "enum": { "type": "array" },
        "minimum": { "type": "number" },
        "minLength": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string" },
        "format": { "type": "string" },
        "const": {},
        "oneOf": { "type": "array", "items": { "$ref": "#/$defs/contract" } },
        "anyOf": { "type": "array", "items": { "$ref": "#/$defs/contract" } },
        "allOf": { "type": "array", "items": { "$ref": "#/$defs/contract" } },
        "$ref": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": true
    },
    "field": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["object", "array", "string", "number", "integer", "boolean", "null"] },
        "description": { "type": "string" },
        "required": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
