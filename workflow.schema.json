{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentflow.dev/schema/workflow-v3.json",
  "title": "AgentFlow Workflow",
  "type": "object",
  "required": [
    "version",
    "name",
    "nodes"
  ],
  "properties": {
    "version": {
      "const": "3"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/input"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "entry": {
      "type": "string",
      "description": "Version 3 entry node"
    },
    "allowUnboundedCycles": {
      "type": "boolean",
      "description": "Explicitly allow cycles with no maxIterations edge; defaults to false"
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      },
      "description": "Version 3 control transitions; $end is terminal"
    }
  },
  "$defs": {
    "edge": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "type": "string",
          "description": "Condition evaluated against run state after the source node completes; the first matching edge is taken"
        },
        "maxIterations": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum traversals of this edge in one run"
        },
        "map": {
          "type": "object",
          "description": "Optional target-input projection. Values may reference input, output, inputs, or nodes with {{ ... }} templates; otherwise the source output is forwarded unchanged."
        }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "path"
          ]
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "execution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "dispatch": {
          "enum": ["first", "all"],
          "description": "Choose the first matching outgoing edge (default) or activate every matching outgoing edge"
        },
        "join": {
          "type": "object",
          "required": ["from"],
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          },
          "description": "Wait for one incoming payload from each listed predecessor; input is an object keyed by predecessor ID"
        },
        "inputSchema": {
          "$ref": "#/$defs/contract",
          "description": "Runtime JSON contract for the rendered node input"
        },
        "outputSchema": {
          "$ref": "#/$defs/contract",
          "description": "Runtime JSON contract for the structured node result"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "retry": {
          "type": "object",
          "properties": {
            "maxAttempts": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "units"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "units": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "execution": {
          "type": "object",
          "required": ["candidates"],
          "additionalProperties": false,
          "properties": {
            "candidates": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/candidate"},
              "description": "Ordered executor choices. Retries are exhausted for one candidate before fallback selects the next."
            },
            "fallback": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "when": {"type": "string", "description": "Boolean Expr evaluated against the structured failure. Omitted means failure.kind == 'start_failed'."}
              },
              "description": "Policy permitting selection of the next candidate."
            }
          }
        }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["executor"],
      "additionalProperties": false,
      "properties": {
        "executor": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the executor registered in executors.json or a built-in executor"
        },
        "config": {
          "type": "object",
          "description": "Opaque executor configuration. The graph engine does not assign business meaning to its keys."
        },
        "session": {"$ref": "#/$defs/session"}
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"type": "string", "enum": ["new", "fixed", "inherit", "fork"]},
        "id": {"type": "string"},
        "from": {"type": "string"}
      }
    },
    "contract": {
      "type": "object",
      "description": "JSON Schema draft 2020-12. The complete definition is compiled by workflow validate, including union types and nested schemas."
    }
  },
  "additionalProperties": false
}
