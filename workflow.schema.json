{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentflow.dev/schema/workflow-v3.json",
  "title": "AgentFlow Workflow",
  "type": "object",
  "required": [
    "version",
    "name",
    "nodes"
  ],
  "properties": {
    "version": {
      "const": "3"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/input"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "entry": {
      "type": "string",
      "description": "Version 3 entry node"
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      },
      "description": "Version 3 control transitions; $end is terminal"
    }
  },
  "$defs": {
    "edge": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "type": "string",
          "description": "Condition evaluated against run state after the source node completes; the first matching edge is taken"
        },
        "maxIterations": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum traversals of this edge in one run"
        }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "path"
          ]
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "executor"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "inputSchema": {
          "$ref": "#/$defs/contract",
          "description": "Runtime JSON contract for the rendered node input"
        },
        "outputSchema": {
          "$ref": "#/$defs/contract",
          "description": "Runtime JSON contract for the structured node result"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "retry": {
          "type": "object",
          "properties": {
            "maxAttempts": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "executor": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the executor registered in .agentflow/executors.json or a built-in executor"
        },
        "config": {
          "type": "object",
          "description": "Opaque executor configuration. The graph engine does not assign business meaning to its keys."
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "session": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "new",
                    "fixed",
                    "inherit",
                    "fork"
                  ]
                },
                "id": {
                  "type": "string"
                },
                "from": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "description": "JSON Schema draft 2020-12. The complete definition is compiled by workflow validate, including union types and nested schemas."
    }
  },
  "additionalProperties": false
}
