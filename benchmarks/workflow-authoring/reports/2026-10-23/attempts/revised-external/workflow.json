{
  "version": "2",
  "name": "durable-copy-review",
  "entry": "draft",
  "inputs": {
    "topic": {
      "type": "string",
      "required": true
    }
  },
  "nodes": [
    {
      "id": "draft",
      "executor": "codex",
      "input": {
        "topic": "{{ inputs.topic }}",
        "feedback": "{{ nodes.review.result.feedback }}",
        "prompt": "请根据主题撰写可直接使用的完整文案。输出严格 JSON，仅包含字符串 summary（完整文案）和 check（自检说明）。主题：{{ inputs.topic }}。本轮返工反馈（首次为空）：{{ nodes.review.result.feedback }}。返工时请落实反馈，并重新输出完整文案。"
      },
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topic": {
            "type": "string"
          },
          "feedback": {
            "type": [
              "string",
              "null"
            ]
          },
          "prompt": {
            "type": "string"
          }
        },
        "required": [
          "topic",
          "feedback",
          "prompt"
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "summary": {
            "type": "string"
          },
          "check": {
            "type": "string"
          }
        },
        "required": [
          "summary",
          "check"
        ]
      },
      "retry": {
        "maxAttempts": 1
      }
    },
    {
      "id": "review",
      "executor": "external",
      "input": {
        "topic": "{{ inputs.topic }}",
        "summary": "{{ nodes.draft.result.summary }}",
        "check": "{{ nodes.draft.result.check }}"
      },
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topic": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "check": {
            "type": "string"
          }
        },
        "required": [
          "topic",
          "summary",
          "check"
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mood": {
            "type": "string",
            "enum": [
              "go",
              "back",
              "stop"
            ]
          },
          "feedback": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "mood",
          "feedback",
          "confidence"
        ]
      }
    },
    {
      "id": "finalize",
      "executor": "codex",
      "input": {
        "topic": "{{ inputs.topic }}",
        "summary": "{{ nodes.draft.result.summary }}",
        "check": "{{ nodes.draft.result.check }}",
        "review": "{{ nodes.review.result }}",
        "prompt": "整理已通过外部审核的文案，输出严格 JSON，仅包含字符串 next_step（整理后的下一步方案）和 verification（验证方法）。主题：{{ inputs.topic }}。完整文案：{{ nodes.draft.result.summary }}。自检：{{ nodes.draft.result.check }}。审核反馈：{{ nodes.review.result.feedback }}。"
      },
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "topic": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "check": {
            "type": "string"
          },
          "review": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mood": {
                "type": "string",
                "enum": [
                  "go",
                  "back",
                  "stop"
                ]
              },
              "feedback": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "mood",
              "feedback",
              "confidence"
            ]
          },
          "prompt": {
            "type": "string"
          }
        },
        "required": [
          "topic",
          "summary",
          "check",
          "review",
          "prompt"
        ]
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "next_step": {
            "type": "string"
          },
          "verification": {
            "type": "string"
          }
        },
        "required": [
          "next_step",
          "verification"
        ]
      },
      "retry": {
        "maxAttempts": 1
      }
    }
  ],
  "edges": [
    {
      "from": "draft",
      "to": "review"
    },
    {
      "from": "review",
      "to": "$end",
      "when": "nodes.review.result.mood == \"stop\""
    },
    {
      "from": "review",
      "to": "finalize",
      "when": "nodes.review.result.mood == \"go\" && nodes.review.result.confidence >= 0.8"
    },
    {
      "from": "review",
      "to": "draft",
      "when": "nodes.review.result.mood == \"back\" || (nodes.review.result.mood == \"go\" && nodes.review.result.confidence < 0.8)",
      "maxIterations": 2
    },
    {
      "from": "finalize",
      "to": "$end"
    }
  ]
}
